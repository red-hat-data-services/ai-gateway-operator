FROM registry.access.redhat.com/ubi9/go-toolset@sha256:c51f0f31cbaa7e91dede6013f636d54fe10dd7d581cfc4cda014ba9d62bcd779 AS builder
ARG TARGETOS=linux
ARG TARGETARCH
ARG CGO_ENABLED=1
ARG LDFLAGS=""
ARG GIT_COMMIT=""
ARG GIT_BRANCH=""
ARG GIT_REPO=""
ARG VERSION=""

USER 0
WORKDIR /opt/app-root/src

COPY go.mod go.sum ./
RUN go mod download

COPY Makefile Makefile
COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/
COPY pkg/ pkg/

COPY config/manifests/batchgateway/ config/manifests/batchgateway/
COPY config/manifests/maascontroller/ config/manifests/maascontroller/
COPY config/manifests/aigatewaycontroller/ config/manifests/aigatewaycontroller/
COPY config/manifests/aigrid/ config/manifests/aigrid/
COPY config/component_metadata.yaml config/manifests/ai-gateway-operator/component_metadata.yaml

RUN VERSION_PKG="github.com/opendatahub-io/ai-gateway-operator/pkg/version" && \
    if [ -z "${LDFLAGS}" ] && [ -n "${GIT_COMMIT}" ]; then \
      LDFLAGS="-X ${VERSION_PKG}.Version=${VERSION} -X ${VERSION_PKG}.Commit=${GIT_COMMIT} -X ${VERSION_PKG}.Branch=${GIT_BRANCH} -X ${VERSION_PKG}.Repo=${GIT_REPO}"; \
    fi && \
    mkdir -p bin && \
    CGO_ENABLED=${CGO_ENABLED} GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    GOEXPERIMENT=strictfipsruntime \
    make build-bin BIN_DIR=/opt/app-root/src/bin BIN_NAME=manager LDFLAGS="${LDFLAGS}"

RUN chmod -R a+rX config/manifests/

FROM registry.redhat.io/ubi9/ubi-minimal-pqc:9.8@sha256:f9a3f225bc0e265827d123f0e07a9f7ae5686d0cb61fa85e55fc589240543d3f
WORKDIR /
COPY --from=builder /opt/app-root/src/bin/manager /manager
COPY --from=builder /opt/app-root/src/config/manifests/ /manifests/

USER 65532:65532
ENTRYPOINT ["/manager"]
